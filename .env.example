# Copia este archivo a ".env" y ajusta los valores según tu instalación de MySQL.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mysql
DB_NAME=reporte_fallas

# Puerto en el que corre el servidor local (http://localhost:PORT)
PORT=3000

# Claves de acceso (equivalentes a HISTORY_ACCESS_CODE y TALLER_ACCESS_CODE en Codigo.gs)
HISTORY_ACCESS_CODE=CHULA2026
TALLER_ACCESS_CODE=Operacion

# Dirección pública para los enlaces de "Solicitud de cotización" que se le
# mandan a un proveedor (ver sección "Proveedores" del Panel). Si la dejas
# vacía o la quitas, el enlace se arma con la dirección desde la que abriste
# el Panel en tu navegador — y si esa fue "localhost", el proveedor NO podrá
# abrirlo desde otra computadora. Pon aquí la dirección de Tailscale de esta
# computadora (algo como http://100.x.x.x:3000, la ves en la app de
# Tailscale o corriendo "tailscale ip" en la terminal), sin diagonal al
# final:
# PUBLIC_BASE_URL=http://100.x.x.x:3000

# Llave de IA (Anthropic/Claude) para las funciones de lectura automática:
# - Leer con IA la foto de la bitácora de diesel llenada a mano (pestaña
#   Combustible Agrícola).
# - Interpretar, por texto escrito, dictado o foto, qué refacciones se
#   necesitan para una orden (columna "Refaccionamiento" del Panel y de
#   Taller).
# Se obtiene en console.anthropic.com (cuenta aparte, con un costo pequeño
# por cada lectura/interpretación) y NO es necesaria para el resto del
# sistema — si se deja vacía, esas dos funciones muestran un aviso pidiendo
# configurarla, y todo lo demás sigue funcionando igual.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
